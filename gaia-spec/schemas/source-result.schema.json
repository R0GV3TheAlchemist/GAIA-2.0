{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://gaia2.org/schemas/source-result.schema.json","title":"GAIA Source Result","description":"A bounded, attributable read-only source retrieval result.","type":"object","additionalProperties":false,"required":["schema_version","source","repository","requested_ref","resolved_commit_sha","path","retrieved_at","content_type","content_hash","source_url","state"],"properties":{"schema_version":{"const":"1.0"},"source":{"const":"github"},"repository":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},"requested_ref":{"type":"string","minLength":1,"maxLength":255},"resolved_commit_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"path":{"type":"string","minLength":1,"maxLength":4096},"blob_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"retrieved_at":{"type":"string","format":"date-time"},"content_type":{"type":"string","minLength":1,"maxLength":255},"content_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"source_url":{"type":"string","format":"uri"},"state":{"type":"string","enum":["complete","truncated","redacted","denied","unavailable","stale"]},"content":{"type":"string","maxLength":1048576},"truncation":{"type":"object","additionalProperties":false,"required":["limit_bytes","observed_bytes"],"properties":{"limit_bytes":{"type":"integer","minimum":1},"observed_bytes":{"type":"integer","minimum":1}}},"policy_decision":{"type":"object","additionalProperties":false,"required":["outcome","rule_id"],"properties":{"outcome":{"type":"string","enum":["allowed","denied","redacted"]},"rule_id":{"type":"string","minLength":1,"maxLength":128},"reason":{"type":"string","maxLength":512}}}},"allOf":[{"if":{"properties":{"state":{"const":"complete"}}},"then":{"required":["content"]}},{"if":{"properties":{"state":{"const":"truncated"}}},"then":{"required":["content","truncation"]}},{"if":{"properties":{"state":{"enum":["redacted","denied"]}}},"then":{"required":["policy_decision"]}}]}