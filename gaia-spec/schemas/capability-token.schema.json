{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaia.example/spec/v0.1/schemas/capability-token.schema.json",
  "title": "GAIA Capability Token",
  "description": "Shape validation for a bounded GAIA capability grant. Signature verification, token issuance, expiry evaluation, delegation evaluation, and revocation checking are runtime conformance responsibilities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "token_id",
    "issuer",
    "subject",
    "resource",
    "operations",
    "constraints",
    "issued_at",
    "expires_at",
    "policy_version",
    "signature"
  ],
  "properties": {
    "token_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable unique identifier for this grant."
    },
    "issuer": {
      "$ref": "#/$defs/entityId"
    },
    "subject": {
      "$ref": "#/$defs/entityId"
    },
    "audience": {
      "$ref": "#/$defs/entityId"
    },
    "resource": {
      "type": "string",
      "minLength": 1,
      "description": "Protected resource selector or namespace."
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "local_only": { "type": "boolean" },
        "max_delegation_depth": { "type": "integer", "minimum": 0 },
        "memory_scope": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "host_allowlist": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "max_cpu_ms": { "type": "integer", "minimum": 1 },
        "max_memory_bytes": { "type": "integer", "minimum": 1 },
        "rate_limit_per_minute": { "type": "integer", "minimum": 1 },
        "consent_reference": { "type": "string", "minLength": 1 }
      },
      "description": "Policy bounds. Implementations may define additional versioned constraints."
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "parent_token_id": {
      "type": "string",
      "minLength": 1,
      "description": "Required by an implementation when this token is delegated."
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "type": "string", "minLength": 1 },
        "key_id": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "entityId": {
      "type": "string",
      "minLength": 1,
      "description": "An identifier unambiguous in the implementation trust domain; DID-compatible identifiers are recommended."
    }
  }
}
