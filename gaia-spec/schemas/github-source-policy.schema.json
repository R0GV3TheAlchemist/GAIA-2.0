{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://gaia2.org/schemas/github-source-policy.schema.json","title":"GAIA GitHub Source Policy","description":"A read-only, server-enforced policy for gaia-github-source.","type":"object","additionalProperties":false,"required":["schema_version","mode","allowed_repositories","allowed_paths","limits","audit"],"properties":{"schema_version":{"const":"1.0"},"mode":{"const":"read-only"},"allowed_repositories":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}},"allowed_paths":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":4096}},"denied_path_patterns":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":4096}},"limits":{"type":"object","additionalProperties":false,"required":["max_file_bytes","max_response_bytes","max_results","requests_per_minute"],"properties":{"max_file_bytes":{"type":"integer","minimum":1,"maximum":10485760},"max_response_bytes":{"type":"integer","minimum":1,"maximum":10485760},"max_results":{"type":"integer","minimum":1,"maximum":1000},"requests_per_minute":{"type":"integer","minimum":1,"maximum":10000},"allowed_content_types":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":255}}}},"audit":{"type":"object","additionalProperties":false,"required":["enabled","chain_required"],"properties":{"enabled":{"const":true},"chain_required":{"const":true}}}}}