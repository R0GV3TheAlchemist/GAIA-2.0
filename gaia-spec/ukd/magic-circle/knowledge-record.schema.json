{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaia.example/spec/ukd/magic-circle/knowledge-record.schema.json",
  "title": "GAIA Magic Circle Knowledge Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "publication_status",
    "epistemic_status",
    "sources",
    "interpretation",
    "diamond",
    "uncertainty",
    "unfinished_horizon",
    "authority"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "ukd_node_id": { "type": "string", "minLength": 1 },
    "publication_status": {
      "enum": [
        "private-draft",
        "approved-for-public-spec",
        "approved-for-public-example",
        "restricted",
        "community-governed",
        "do-not-store"
      ]
    },
    "epistemic_status": {
      "enum": [
        "observation",
        "data",
        "information",
        "evidence",
        "knowledge_claim",
        "interpretation",
        "understanding",
        "wisdom_judgment",
        "stewardship_application"
      ]
    },
    "library_ring": {
      "enum": [
        "history",
        "science",
        "art",
        "nature",
        "ethics",
        "philosophy",
        "engineering",
        "human_experience",
        "place",
        "language_oral_tradition"
      ]
    },
    "learning_path": {
      "enum": ["discovery", "memory", "understanding", "application"]
    },
    "claim": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "kind"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": [
              "observation",
              "document",
              "dataset",
              "community_authority",
              "user_declared",
              "historical",
              "fictional"
            ]
          },
          "provenance": { "type": "string", "minLength": 1 }
        }
      }
    },
    "interpretation": { "type": "string", "minLength": 1 },
    "application": { "type": "string", "minLength": 1 },
    "diamond": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truth", "memory", "discovery", "understanding", "wisdom"],
      "properties": {
        "truth": { "type": "string", "minLength": 1 },
        "memory": { "type": "string", "minLength": 1 },
        "discovery": { "type": "string", "minLength": 1 },
        "understanding": { "type": "string", "minLength": 1 },
        "wisdom": { "type": "string", "minLength": 1 }
      }
    },
    "symbology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "operational_claim"],
      "properties": {
        "category": {
          "enum": [
            "formal_geometry",
            "historical_alchemy",
            "astronomy_zodiac_history",
            "religious_spiritual",
            "indigenous_community_held",
            "fiction",
            "personal_symbolism",
            "empirical_claim",
            "none"
          ]
        },
        "operational_claim": { "type": "boolean" },
        "accountability_mapping": { "type": "string", "minLength": 1 }
      }
    },
    "uncertainty": { "type": "string", "minLength": 1 },
    "dissent": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "correction_path": { "type": "string", "minLength": 1 },
    "unfinished_horizon": { "type": "string", "minLength": 1 },
    "viriditas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tradition_contextual", "generative_effects", "concealed_harm"],
      "properties": {
        "tradition_contextual": { "const": true },
        "generative_effects": { "type": "string", "minLength": 1 },
        "concealed_harm": { "type": "string", "minLength": 1 }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "consent_status", "community_authority"],
      "properties": {
        "status": {
          "enum": [
            "advisory_only",
            "requires_community_authority",
            "not_authorized_to_store"
          ]
        },
        "consent_status": {
          "enum": ["not_required", "valid", "missing", "refused"]
        },
        "community_authority": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "symbology": {
            "properties": { "operational_claim": { "const": true } },
            "required": ["operational_claim"]
          }
        },
        "required": ["symbology"]
      },
      "then": {
        "properties": {
          "symbology": {
            "required": ["category", "operational_claim", "accountability_mapping"]
          }
        }
      }
    }
  ]
}
