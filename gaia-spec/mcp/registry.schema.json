{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaia-os.org/spec/mcp/registry.schema.json",
  "title": "GAIA-MCP Registry Entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "display_name", "capabilities", "contract_versions", "trust", "endpoint"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{2,127}$"},
    "type": {"enum": ["tool", "agent", "workflow", "data_service"]},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 160},
    "aip_manifest": {"type": "string", "format": "uri-reference"},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "input_schema": {"type": "string", "format": "uri-reference"},
    "output_schema": {"type": "string", "format": "uri-reference"},
    "contract_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]+\.[0-9]+\.[0-9]+$"}},
    "jurisdictions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "data_classifications": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "trust": {"type": "object", "additionalProperties": false, "required": ["required"], "properties": {"required": {"type": "string"}, "policy_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "endpoint": {"type": "object", "additionalProperties": false, "required": ["transport", "address"], "properties": {"transport": {"enum": ["in_process", "stdio", "streamable_http", "websocket"]}, "address": {"type": "string", "minLength": 1}}}
  },
  "allOf": [{"if": {"properties": {"type": {"const": "agent"}}}, "then": {"required": ["aip_manifest"]}}]
}
