{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaia.example/spec/sos/intent.schema.json",
  "title": "GAIA Intent ABI",
  "description": "Structural contract for a signed GAIA Intent record. Cryptographic validity, freshness, replay protection, grant resolution, consent, revocation, and policy are runtime checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "intent_id",
    "issued_at",
    "expires_at",
    "subject",
    "goal",
    "authorization",
    "constraints",
    "context",
    "nonce",
    "signature"
  ],
  "properties": {
    "spec_version": {
      "const": "gaia.intent/v0.1"
    },
    "intent_id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["did", "kind"],
      "properties": {
        "did": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:.+$",
          "maxLength": 512
        },
        "kind": {
          "enum": ["human", "agent", "device", "service", "organization"]
        }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "purpose"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "outcome": {
          "type": "string",
          "maxLength": 4096
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grant_id", "capabilities", "delegation", "confirmation"],
      "properties": {
        "grant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
          }
        },
        "delegation": {
          "enum": ["none", "single_hop", "bounded_chain"]
        },
        "confirmation": {
          "enum": ["not_required", "required_before_invoke", "already_confirmed"]
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["side_effects", "network", "data_classes", "max_runtime_seconds"],
      "properties": {
        "side_effects": {
          "enum": ["none", "read_only", "reversible", "requires_confirmation"]
        },
        "network": {
          "enum": ["deny", "local_only", "allowlisted"]
        },
        "data_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["public", "user_private", "community_governed", "restricted", "biometric_forbidden"]
          }
        },
        "max_runtime_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memcube_refs"],
      "properties": {
        "memcube_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^urn:gaia:memcube:.+$",
            "maxLength": 1024
          }
        },
        "region": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {
              "enum": ["named_region", "bbox", "geojson_ref"]
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        "provenance_requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["source_required", "license_required", "uncertainty_required", "synthetic_label_required"]
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": ["agent", "tool", "executor", "workflow"]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "nonce": {
      "type": "string",
      "minLength": 16,
      "maxLength": 512
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "payload_hash", "value"],
      "properties": {
        "algorithm": {
          "enum": ["Ed25519", "ECDSA_P256_SHA256"]
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "payload_hash": {
          "type": "string",
          "pattern": "^sha256:[a-fA-F0-9]{64}$"
        },
        "value": {
          "type": "string",
          "minLength": 32,
          "maxLength": 16384
        }
      }
    }
  }
}
